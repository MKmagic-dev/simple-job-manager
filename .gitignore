/android/app/release

# Secrets
.env

# Generated localization code (regenerate with `flutter gen-l10n`)
/lib/l10n/generated/

# Supabase CLI local cache (project link info, not meant for version control)
/supabase/.temp/

# Claude Code runtime state (machine-local, not project config)
/.claude/scheduled_tasks.lock
